{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/nds-forge/project.schema.json",
  "title": "NDS Forge project configuration",
  "type": "object",
  "required": ["schema_version", "project_id", "region", "source", "pipeline"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "workspace": {"type": "string", "minLength": 1},
    "region": {
      "type": "object",
      "required": ["source"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "source": {"enum": ["bbox", "boundary_geojson", "relation"]},
        "bbox": {"type": "array", "prefixItems": [
          {"type": "number", "minimum": -180, "maximum": 180},
          {"type": "number", "minimum": -90, "maximum": 90},
          {"type": "number", "minimum": -180, "maximum": 180},
          {"type": "number", "minimum": -90, "maximum": 90}], "minItems": 4, "maxItems": 4},
        "boundary_geojson": {"type": "string"},
        "osm_relation_id": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"const": "pbf"},
        "path": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "sha256": {"anyOf": [{"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}, {"const": ""}]},
        "license": {"type": "string"},
        "attribution": {"type": "string"}
      },
      "anyOf": [{"required": ["path"]}, {"required": ["url"]}],
      "additionalProperties": true
    },
    "pipeline": {
      "type": "object",
      "properties": {
        "target": {"type": "string"},
        "enable_experimental": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "osm": {
      "type": "object",
      "properties": {
        "highway_values": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": true
    },
    "neusoft": {"type": "object"}
  },
  "additionalProperties": true
}
